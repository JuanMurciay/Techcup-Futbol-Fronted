# Desarrollo: deja VITE_API_URL sin definir y usa `npm run dev` (proxy → https://localhost:8443).
# Producción o preview sin proxy:
# VITE_API_URL=https://localhost:8443

# Si tu API corre en otro host/puerto (solo proxy de Vite en dev):
# VITE_DEV_API_PROXY=https://localhost:8443

# Login con Google (OAuth en el backend). Por defecto se redirige a `/oauth2/authorization/google`
# (mismo origen en dev gracias al proxy de Vite hacia el back).
# URL completa si tu back expone otra ruta:
# VITE_GOOGLE_AUTH_URL=https://localhost:8443/oauth2/authorization/google
# Solo el path (si el host es VITE_API_URL o el origen en dev):
# VITE_GOOGLE_OAUTH_PATH=/oauth2/authorization/google
